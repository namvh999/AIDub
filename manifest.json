{
  "manifest_version": 3,
  "name": "Gemini Video Dubbing",
  "version": "1.2.3",
  "description": "Lồng tiếng video theo thời gian thực bằng Gemini; hỗ trợ lọc quảng cáo YouTube và tự bỏ qua quảng cáo Youku.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "declarativeNetRequest",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://*/*",
    "https://*/*",
    "https://*.youtube.com/*",
    "https://*.youku.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["ad-filter.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://*.youku.com/*"],
      "js": ["youku-ad-skip.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["youtube-ad-filter.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["youtube-main-world.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com;"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Lồng tiếng video AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
